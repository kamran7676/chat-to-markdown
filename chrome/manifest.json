{
  "manifest_version": 3,
  "name": "Chat to Markdown",
  "version": "0.6.1",
  "description": "Export LLM chat conversations as clean Markdown or API-format YAML — copy, download, or preview.",
  "homepage_url": "https://chatup.therobot.codes",
  "permissions": ["clipboardWrite", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "src/lib/markdown.js",
        "src/lib/export.js",
        "src/lib/contextpack.js",
        "src/content/adapters/tool-calls.js",
        "src/content/adapters/generic.js",
        "src/content/adapters/chatgpt.js",
        "src/content/adapters/claude.js",
        "src/content/adapters/gemini.js",
        "src/content/adapters/openwebui.js",
        "src/content/adapters/mistral.js",
        "src/content/adapters/useai.js",
        "src/content/adapters/grok.js",
        "src/content/adapters/groq.js",
        "src/content/adapters/index.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "110"
}
